{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "routes": [
    { "src": "/", "dest": "/home-v12.html" },
    { "src": "/facebook-auto-reply", "dest": "/facebook-auto-reply.html" },
    { "src": "/whatsapp-auto-reply", "dest": "/whatsapp-auto-reply.html" },
    { "src": "/online-shop-website", "dest": "/online-shop-website.html" },
    { "src": "/f-commerce", "dest": "/f-commerce.html" },
    { "src": "/fashion-online-shop", "dest": "/fashion-online-shop.html" },
    { "src": "/kids-wear-online-shop", "dest": "/kids-wear-online-shop.html" },
    { "src": "/cosmetics-online-shop", "dest": "/cosmetics-online-shop.html" },
    { "src": "/food-online-shop", "dest": "/food-online-shop.html" },
    { "src": "/electronics-online-shop", "dest": "/electronics-online-shop.html" },
    { "src": "/jewelry-online-shop", "dest": "/jewelry-online-shop.html" },
    { "src": "/home-decor-online-shop", "dest": "/home-decor-online-shop.html" },
    { "src": "/general-store-online-shop", "dest": "/general-store-online-shop.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
